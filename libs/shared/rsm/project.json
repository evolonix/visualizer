{
  "name": "lib-shared-rsm",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/rsm/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/rsm",
        "main": "libs/shared/rsm/src/index.ts",
        "tsConfig": "libs/shared/rsm/tsconfig.lib.json",
        "assets": ["libs/shared/rsm/*.md"]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs rsm {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/rsm/jest.config.ts"
      }
    }
  },
  "tags": ["type:data-access", "scope:shared"]
}
