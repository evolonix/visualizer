{
  "name": "lib-assistant-chatbot",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/assistant/chatbot/src",
  "prefix": "dgx",
  "tags": [],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/assistant/chatbot/ng-package.json"
      },
      "assets": [
        {
          "input": "libs/assistant/chatbot/src/lib/assets/**",
          "glob": "**.*",
          "output": "assets"
        }
      ],
      "configurations": {
        "production": {
          "tsConfig": "libs/assistant/chatbot/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/assistant/chatbot/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/assistant/chatbot/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
